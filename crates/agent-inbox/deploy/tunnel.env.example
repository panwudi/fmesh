# Trusted shell assignments. Copy once per session and fill the absolute paths.
INBOX_SSH_USER='agent-tunnel'
INBOX_BIN='/absolute/path/to/agent-inbox'
INBOX_SSH_KEY='/absolute/path/to/this-session-tunnel-key'
INBOX_KNOWN_HOSTS='/absolute/path/to/pinned-known-hosts'
INBOX_HOST_KEY_ALIAS='inbox-hub'
INBOX_SSH_CONFIG='/absolute/path/to/inbox-hub.ssh'
# All sessions on this host targeting this relay must use this exact persistent file.
INBOX_DIAL_LOCK_FILE="$HOME/.local/state/agent-inbox/hub.dial.lock"

# Sample endpoints; change these for your relay.
INBOX_INTR_HOST='192.0.2.10'
INBOX_INTR_PORT=22
INBOX_PUBLIC_HOST='hub.example.com'
INBOX_PUBLIC_PORT=2222
INBOX_INTR_PREFIX='192.0.2.0/24'
# Optional IPv4 default gateway; an empty value uses only the prefix rule.
INBOX_INTR_GATEWAY=''

# Example Claude wiring. Codex uses its own four ports as needed.
INBOX_LOCAL_INBOX_PORT=8797
INBOX_REVERSE_PORT=8817
INBOX_LOCAL_SEND_PORT=8821
INBOX_HUB_PORT=8811

INBOX_OUTER_CONNECT_TIMEOUT=45
INBOX_DIAL_TIMEOUT=45
INBOX_ALIVE_INTERVAL=15
INBOX_ALIVE_COUNT=3
INBOX_BACKOFF_INITIAL=15
INBOX_BACKOFF_MAX=300
INBOX_STABLE_RESET=300

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- flytoMesh tray icon, per logged-in user. Install: /Library/LaunchAgents/com.flyto.meshtray.plist,
     root:wheel 644. Quitting it from its menu does not bring it back until the next login
     (KeepAlive only on a crash), and never affects the network. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.flyto.meshtray</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/flytomesh/meshtray</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
</dict>
</plist>

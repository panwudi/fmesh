<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- flytoMesh node on macOS. Install: /Library/LaunchDaemons/com.flyto.meshd.plist, root:wheel 644.
     Files in /etc/flytomesh: key, admin.pub, roster. meshd exits after taking a newer roster
     from a relay; KeepAlive brings it back with the new one. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.flyto.meshd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/flytomesh/meshd</string>
        <string>up</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>2</integer>
    <key>StandardErrorPath</key>
    <string>/var/log/meshd.log</string>
    <key>StandardOutPath</key>
    <string>/var/log/meshd.log</string>
</dict>
</plist>
